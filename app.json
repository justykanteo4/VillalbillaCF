{
  "expo": {
    "name": "VillalbillaCF",
    "slug": "villalbilla-cf",
    "icon": "./assets/app-icon-crest.png",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.villalbilla.cf",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-crest.png",
        "monochromeImage": "./assets/app-icon-crest.png",
        "backgroundColor": "#0b121d"
      }
    },
    "web": {
      "name": "VillalbillaCF",
      "favicon": "./assets/app-icon-crest.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir una foto para la plantilla de Villalbilla C.F.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8aa9b217-1386-4b74-9a15-9e93d127030b"
      }
    },
    "owner": "justykanteo4"
  }
}
