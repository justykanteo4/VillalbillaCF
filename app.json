{
  "expo": {
    "name": "VillalbillaCF",
    "slug": "villalbilla-cf",
    "scheme": "villalbilla-cf",
    "icon": "./assets/app-icon-crest.png",
    "version": "0.1.8",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.villalbilla.cf",
      "buildNumber": "2",
      "associatedDomains": [
        "applinks:villalbillacf.firebaseapp.com"
      ]
    },
    "android": {
      "package": "com.villalbilla.cf",
      "versionCode": 11,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "villalbillacf.firebaseapp.com",
              "pathPrefix": "/__/auth/links"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-crest.png",
        "monochromeImage": "./assets/app-icon-crest.png",
        "backgroundColor": "#0b121d"
      }
    },
    "web": {
      "name": "VillalbillaCF",
      "favicon": "./assets/app-icon-crest.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir una foto para la plantilla de Villalbilla C.F.",
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.758134560563-j98or1f7n4jrfanklgo1pg85davlvt9p"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8aa9b217-1386-4b74-9a15-9e93d127030b"
      }
    },
    "owner": "justykanteo4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8aa9b217-1386-4b74-9a15-9e93d127030b",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
