rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function isAdmin() {
      return verifiedAccount() && (
        request.auth.token.email in [
          'albaresfernandez@gmail.com',
          'appvillalbilla@gmail.com'
        ]
        || exists(/databases/$(database)/documents/clubAdmins/$(request.auth.token.email))
      );
    }

    function validClaim(claim) {
      return claim is map
        && claim.teamId is string
        && claim.name is string
        && claim.name.size() > 0
        && claim.category is string
        && claim.teamName is string;
    }

    function approvedFor(teamId) {
      let path = /databases/$(database)/documents/trainerProfiles/$(request.auth.uid);
      return verifiedAccount() && exists(path)
        && get(path).data.status == 'approved'
        && get(path).data.claim.teamId == teamId;
    }

    match /trainerProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && ((request.resource.data.status == 'unassigned'
              && request.resource.data.claim == null)
            || (request.resource.data.status == 'pending'
              && validClaim(request.resource.data.claim)));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == 'pending'
        && validClaim(request.resource.data.claim)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['claim', 'status', 'updatedAt']));
      allow delete: if false;
    }

    match /teamWorkspaces/{teamId} {
      allow read, write: if isAdmin() || approvedFor(teamId);
    }

    match /clubAdmins/{email} {
      allow get: if verifiedAccount() && request.auth.token.email == email || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'createdBy', 'createdAt'])
        && request.resource.data.email == email
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
