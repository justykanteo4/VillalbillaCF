{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "villalbilla-cf",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
