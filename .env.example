# Solo en el servidor. Nunca usar EXPO_PUBLIC para secretos.
TRAINER_PASSWORD=
# Token de Instagram profesional autorizado para villalbillacf (instagram_business_basic).
INSTAGRAM_ACCESS_TOKEN=
# Token de usuario de Facebook con pages_show_list, pages_read_engagement e instagram_basic.
# La cuenta profesional de Instagram debe estar enlazada a una página administrada por ese usuario.
INSTAGRAM_FACEBOOK_ACCESS_TOKEN=
PORT=8081
HOST=127.0.0.1
# En móvil: dirección HTTPS pública de Cloudflare Workers (sin barra final).
EXPO_PUBLIC_API_URL=

# Identificadores OAuth de Google (el administrador se verifica en servidor).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Firebase Web App (valores públicos de la app Firebase; nunca incluir claves privadas)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Email-link return URL uses the project's authorized Firebase Hosting domain.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Envío de códigos y verificación de cuentas por correo
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Activar siempre al publicar bajo HTTPS
SESSION_COOKIE_SECURE=false

# Web push: Firebase Console > Cloud Messaging > Web Push certificates
EXPO_PUBLIC_FIREBASE_VAPID_KEY=
