rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedAccount() {
      return signedIn() && (
        request.auth.token.email_verified == true
        || request.auth.token.firebase.sign_in_provider == 'google.com'
      );
    }

    function isAdmin() {
      return verifiedAccount() && (
        request.auth.token.email in [
          'albaresfernandez@gmail.com',
          'appvillalbilla@gmail.com'
        ]
        || exists(/databases/$(database)/documents/clubAdmins/$(request.auth.token.email))
      );
    }

    function validClaim(claim) {
      return claim is map
        && claim.teamId is string
        && claim.name is string
        && claim.name.size() > 0
        && claim.category is string
        && claim.teamName is string
        && (!('teamIds' in claim) || (claim.teamIds is list && claim.teamIds.size() > 0 && claim.teamIds.size() <= 30 && claim.teamId in claim.teamIds));
    }

    function approvedFor(teamId) {
      let path = /databases/$(database)/documents/trainerProfiles/$(request.auth.uid);
      return verifiedAccount() && exists(path)
        && get(path).data.status == 'approved'
        && (get(path).data.claim.teamId == teamId
          || ('teamIds' in get(path).data.claim && teamId in get(path).data.claim.teamIds))
        && (!('role' in get(path).data.claim) || get(path).data.claim.role == 'trainer');
    }

    match /trainerProfiles/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && !('accessNotice' in request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && ((request.resource.data.status == 'unassigned'
              && request.resource.data.claim == null)
            || (request.resource.data.status == 'pending'
              && validClaim(request.resource.data.claim)));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == 'pending'
        && validClaim(request.resource.data.claim)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['claim', 'status', 'updatedAt']));
      allow delete: if false;
    }

    match /teamWorkspaces/{teamId} {
      allow read, write: if isAdmin() || approvedFor(teamId);
    }

    match /notificationSubscriptions/{id} {
      allow read, delete: if signedIn() && resource.data.owner == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && (!exists(/databases/$(database)/documents/notificationSubscriptions/$(id)) || resource.data.owner == request.auth.uid)
        && request.resource.data.keys().hasOnly(['owner','enabled','teamIds','playerIds','token','provider','consentedAt','updatedAt'])
        && request.resource.data.enabled is bool
        && request.resource.data.teamIds is list && request.resource.data.teamIds.size() <= 100
        && request.resource.data.playerIds is list && request.resource.data.playerIds.size() <= 500
        && request.resource.data.token is string && request.resource.data.token.size() < 4096
        && request.resource.data.provider in ['expo','fcm']
        && request.resource.data.updatedAt == request.time;
    }
    match /clubNotifications/{id} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['title','body','all','teamIds','playerIds','createdBy','createdAt'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 2000
        && request.resource.data.all is bool
        && request.resource.data.teamIds is list && request.resource.data.teamIds.size() <= 100
        && request.resource.data.playerIds is list && request.resource.data.playerIds.size() <= 500
        && (request.resource.data.all || request.resource.data.teamIds.size() > 0 || request.resource.data.playerIds.size() > 0);
      allow update, delete: if false;
    }


    function chatProfile(uid) {
      return get(/databases/$(database)/documents/trainerProfiles/$(uid)).data;
    }
    function chatApproved(uid, teamId) {
      let p = chatProfile(uid);
      return p.status in ['approved', 'admin'] && p.claim.role in ['trainer', 'player']
        && (p.claim.teamId == teamId || ('teamIds' in p.claim && teamId in p.claim.teamIds));
    }
    function chatAccess(teamId) {
      return signedIn() && chatApproved(request.auth.uid, teamId);
    }
    function validChatMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['body', 'senderId', 'senderName', 'createdAt'])
        && d.senderId == request.auth.uid
        && d.senderName == chatProfile(request.auth.uid).claim.name
        && d.body is string && d.body.size() > 0 && d.body.size() <= 2000
        && d.createdAt == request.time;
    }
    function privateChatAccess(teamId, ids) {
      return chatAccess(teamId) && ids is list && ids.size() == 2
        && ids[0] != ids[1] && request.auth.uid in ids
        && chatApproved(ids[0], teamId) && chatApproved(ids[1], teamId);
    }
    match /teamChats/{teamId} {
      match /members/{uid} {
        allow read: if chatAccess(teamId);
        allow create, update: if chatAccess(teamId) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'role'])
          && request.resource.data.uid == uid
          && request.resource.data.name == chatProfile(uid).claim.name
          && request.resource.data.role == chatProfile(uid).claim.role;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
      match /messages/{messageId} {
        allow read: if chatAccess(teamId);
        allow create: if chatAccess(teamId) && validChatMessage();
        allow update, delete: if false;
      }
      match /direct/{threadId} {
        allow get: if chatAccess(teamId) && (!exists(/databases/$(database)/documents/teamChats/$(teamId)/direct/$(threadId))
          || privateChatAccess(teamId, resource.data.memberIds));
        allow list: if false;
        allow create: if request.resource.data.keys().hasOnly(['memberIds'])
          && privateChatAccess(teamId, request.resource.data.memberIds);
        allow update, delete: if false;
        match /messages/{messageId} {
          allow read: if privateChatAccess(teamId, get(/databases/$(database)/documents/teamChats/$(teamId)/direct/$(threadId)).data.memberIds);
          allow create: if privateChatAccess(teamId, get(/databases/$(database)/documents/teamChats/$(teamId)/direct/$(threadId)).data.memberIds)
            && validChatMessage();
          allow update, delete: if false;
        }
      }
    }

    match /clubAdmins/{email} {
      allow get: if verifiedAccount() && request.auth.token.email == email || isAdmin();
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['email', 'createdBy', 'createdAt'])
        && request.resource.data.email == email
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if false;
    }
  }
}
